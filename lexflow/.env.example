# Copiar a .env y completar. Estas claves se incrustan en el build.
# Solo la clave PUBLICA (anon) va aquí. El .env NUNCA se sube a GitHub.
VITE_SUPABASE_URL=https://tu-proyecto.supabase.co
VITE_SUPABASE_ANON_KEY=tu-anon-public-key
# Vacía en local (usa el proxy /api -> localhost:5000).
# En Netlify: URL del backend Flask en Render, ej.
# https://lexflow-api.onrender.com (sin barra final).
# Obligatoria para Ajustes → Usuarios (crea/resetea claves vía service key).
VITE_API_URL=
